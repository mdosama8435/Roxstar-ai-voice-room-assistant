# ==============================================================================
# ROXSTAR AI VOICE ROOM ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Copy this file to .env for local development. Never commit .env to git.
# Use placeholders only in this file. Put real keys only in local .env (gitignored).

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Frontend public API target (used in frontend/.env.local)
# Production build: set to https://your-api.example.com BEFORE `next build`
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# LiveKit Cloud / Server Configuration
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_ROOM_NAME=roxstar-test
# AI media in FastAPI process (default). Production: ONE process, ONE worker, NO --reload.
AI_MEDIA_IN_BACKEND=true

# ------------------------------------------------------------------------------
# Speech AI Providers - Sarvam Realtime STT (Phase 3A)
# STT_PROVIDER options: sarvam (default), mock (local/tests only)
STT_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_placeholder
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_SAMPLE_RATE=16000

# STT WebSocket Session Authentication (REQUIRED when ENVIRONMENT=production)
STT_TOKEN_SECRET=your_stt_token_secret_or_leave_blank

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Phase 3C Gemini Primary + Phase 3C.1 NVIDIA NIM Fallback)
# ------------------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=nvidia
LLM_ENABLE_FALLBACK=true

# Primary: Google Gemini (official google-genai SDK)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_placeholder
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=300
LLM_TIMEOUT_SECONDS=15.0

# Secondary Fallback: NVIDIA NIM (OpenAI-compatible SDK)
NVIDIA_API_KEY=your_nvidia_nim_api_key_placeholder
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------------------
# Memory & Persistence Layer (Optional local dev with Docker Compose)
# ------------------------------------------------------------------------------
# PostgreSQL + pgvector for persistent semantic memory & user profiles
DATABASE_URL=postgresql://roxstar:roxstar_secret@localhost:5432/roxstar_db

# Redis for ephemeral room session cache & fast turn arbitration locks
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Phase 3D: TTS Provider Configuration (Sarvam Bulbul v3)
# IMPORTANT: SARVAM_TTS_API_KEY is SEPARATE from SARVAM_API_KEY (STT).
#            Do NOT reuse or confuse these two credentials.
# TTS_PROVIDER options: sarvam (default for real mode), mock (explicit testing only)
# ------------------------------------------------------------------------------
TTS_PROVIDER=sarvam
SARVAM_TTS_API_KEY=your_sarvam_tts_api_key_placeholder
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=hi-IN

# Voices: verified from sarvamai SDK configure() source code
# AI Dost (male companion voice): shubh
# AI Sathi (female companion voice): priya
SARVAM_TTS_DOST_SPEAKER=shubh
SARVAM_TTS_SATHI_SPEAKER=priya

# bulbul:v3 does NOT support pitch or loudness (only pace and temperature)
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6

# Audio format: linear16 = raw PCM, compatible with LiveKit AudioFrame
# Verified: sarvamai SDK accepts 'linear16' as output_audio_codec
SARVAM_TTS_OUTPUT_CODEC=linear16
# Sample rate: 24000 Hz is bulbul:v3 default. LiveKit AudioFrame is configured to match.
SARVAM_TTS_SAMPLE_RATE=24000

# Text chunking policy: primary boundaries . ? ! ।; comma as secondary fallback
TTS_CHUNK_MIN_CHARS=40
TTS_CHUNK_MAX_CHARS=250
TTS_AUDIO_QUEUE_MAXSIZE=50
